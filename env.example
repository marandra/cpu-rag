# Required
RAG_API_KEY=your-secret-key-here

# Optional overrides (defaults work for container)
# MODEL_PATH=./models/Ministral-3-3B-Q4_K_M.gguf
# ALLOWED_ORIGINS=["http://localhost:3000","https://app.example.com"]
# GENERATION_TIMEOUT=60.0
# MAX_TOKENS=256
# LOG_LEVEL=INFO

# Pool topology (laptop i7-1365U defaults)
# Threads per replica — must match the cpuset size below.
# RAG_N_THREADS=2
# Replica pinning. Laptop: P-cores 0,2 ; E-cores 4,5. HPC: leave unset or set
# to homogeneous ranges (e.g. 0-7 and 8-15).
# RAG_1_CPUSET=0,2
# RAG_2_CPUSET=4,5
# Host port exposed by the nginx LB
# RAG_LB_PORT=8000
