# Deployment profile: glucowise — diabetes only.
#
# Consumed twice by docker compose (see ./run.sh): as --env-file, to
# interpolate the compose file, and as a service env_file, to reach the
# containers. Secrets stay in .env (gitignored); this file is safe to commit.

# Selects PROFILES["glucowise"] in app/config.py. Also names the containers
# (glucowise-1, glucowise-nginx, ...) and the snapshots subdir.
PROFILE=glucowise

# Points the service env_file back at this file.
RAG_ENV_FILE=profiles/glucowise.env

# Host port for the nginx load balancer.
RAG_LB_PORT=8001
